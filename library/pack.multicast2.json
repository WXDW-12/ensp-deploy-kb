{
  "pack": "multicast2",
  "meta": {"name": "组播命令精编（IGMP / PIM / MSDP）", "version": "0.1.0", "updated": "2026-11-06"},
  "commands": [
    {"id": "mcast.pim_sm", "category": "组播 PIM", "title": "启用 PIM-SM（接口）", "keywords": ["pim sm", "组播", "稀疏模式"], "risk": "medium",
     "params": {"req": ["iface"], "ex": {"iface": "Vlanif10"}},
     "config": {"huawei": ["system-view", "multicast routing-enable", "interface {{iface}}", "pim sm", "quit"],
                "cisco": ["configure terminal", "ip multicast-routing", "interface {{iface}}", "ip pim sparse-mode", "end"],
                "h3c": ["system-view", "multicast routing", "interface {{iface}}", "pim sm", "quit"]},
     "verify": {"huawei": ["display pim interface"], "cisco": ["show ip pim interface"], "h3c": ["display pim interface"]},
     "note": "组播必须先开全局 multicast routing-enable，再在接口开 PIM，两步缺一不可。"},
    {"id": "mcast.igmp_enable", "category": "组播 IGMP", "title": "接口启用 IGMP", "keywords": ["igmp enable", "组播成员"], "risk": "medium",
     "params": {"req": ["iface"], "ex": {"iface": "Vlanif10"}},
     "config": {"huawei": ["system-view", "multicast routing-enable", "interface {{iface}}", "igmp enable", "quit"],
                "cisco": ["configure terminal", "interface {{iface}}", "ip igmp version 2", "end"],
                "h3c": ["system-view", "multicast routing", "interface {{iface}}", "igmp enable", "quit"]},
     "verify": {"huawei": ["display igmp interface"], "cisco": ["show ip igmp interface"], "h3c": ["display igmp interface"]}},
    {"id": "mcast.igmp_snooping", "category": "组播 IGMP", "title": "配置二层组播侦听（snooping）", "keywords": ["igmp-snooping", "二层组播", "snooping"], "risk": "medium",
     "params": {"req": ["vlans"], "ex": {"vlans": "10 20"}},
     "config": {"huawei": ["system-view", "igmp-snooping enable", "vlan {{vlans|space}}", "igmp-snooping enable", "quit"],
                "cisco": ["configure terminal", "ip igmp snooping", "ip igmp snooping vlan {{vlans|comma}}", "end"],
                "h3c": ["system-view", "igmp-snooping", "vlan {{vlans|space}}", "igmp-snooping enable", "quit"]},
     "note": "没开 snooping 时组播会在 VLAN 内泛洪，开了才按需转发。"},
    {"id": "mcast.static_group", "category": "组播 IGMP", "title": "配置静态组播组", "keywords": ["static-group", "静态组"], "risk": "low",
     "params": {"req": ["iface", "group"], "ex": {"iface": "GigabitEthernet0/0/1", "group": "225.1.1.1"}},
     "config": {"huawei": ["system-view", "interface {{iface}}", "igmp static-group {{group}}", "quit"],
                "cisco": ["configure terminal", "interface {{iface}}", "ip igmp static-group {{group}}", "end"],
                "h3c": ["system-view", "interface {{iface}}", "igmp static-group {{group}}", "quit"]}},
    {"id": "mcast.rpf_static", "category": "组播 路由管理", "title": "配置组播静态路由（RPF）", "keywords": ["rpf-route-static", "mroute", "组播静态路由"], "risk": "medium",
     "params": {"req": ["dest", "mask", "nexthop"], "ex": {"dest": "10.10.0.0", "mask": "255.255.255.0", "nexthop": "10.0.0.2"}},
     "config": {"huawei": ["system-view", "ip rpf-route-static {{dest}} {{mask}} {{nexthop}}"],
                "cisco": ["configure terminal", "ip mroute {{dest}} {{mask}} {{nexthop}}", "end"],
                "h3c": ["system-view", "ip rpf-route-static {{dest}} {{mask}} {{nexthop}}"]},
     "verify": {"huawei": ["display multicast routing-table static"], "cisco": ["show ip mroute static"], "h3c": ["display multicast routing-table static"]},
     "note": "组播靠 RPF 查表转发；单播路由不对称时用它强制指定上游。"},
    {"id": "mcast.static_rp", "category": "组播 PIM", "title": "配置静态 RP", "keywords": ["static-rp", "rp", "rendezvous"], "risk": "medium",
     "params": {"req": ["rp"], "ex": {"rp": "1.1.1.1"}},
     "config": {"huawei": ["system-view", "pim", "static-rp {{rp}}", "quit"],
                "cisco": ["configure terminal", "ip pim rp-address {{rp}}", "end"],
                "h3c": ["system-view", "pim", "static-rp {{rp}}", "quit"]},
     "verify": {"huawei": ["display pim rp-info"], "cisco": ["show ip pim rp mapping"], "h3c": ["display pim rp-info"]},
     "note": "小网络用静态 RP 最省事；大网络用 BSR/Anycast-RP。"},
    {"id": "mcast.msdp_peer", "category": "组播 MSDP", "title": "配置 MSDP 对等体", "keywords": ["msdp", "peer", "源发现"], "risk": "medium",
     "params": {"req": ["peer"], "opt": ["src_iface"], "ex": {"peer": "10.0.0.2", "src_iface": "LoopBack0"}},
     "config": {"huawei": ["system-view", "msdp", "peer {{peer}} connect-interface [[{{src_iface}}]]", "quit"],
                "cisco": ["configure terminal", "ip msdp peer {{peer}} connect-source [[{{src_iface}}]]", "end"],
                "h3c": ["system-view", "msdp", "peer {{peer}} connect-interface [[{{src_iface}}]]", "quit"]},
     "verify": {"huawei": ["display msdp peer-status"], "cisco": ["show ip msdp summary"], "h3c": ["display msdp peer-status"]},
     "note": "跨 PIM 域共享源信息；需要先有 PIM-SM 和 RP。"},
    {"id": "mcast.show_route", "category": "组播 查看", "title": "查看组播路由表", "keywords": ["display pim routing-table", "show ip mroute", "组播路由"], "risk": "read-only",
     "params": {"req": [], "opt": ["group"], "ex": {"group": "225.1.1.1"}},
     "config": {"huawei": ["display pim routing-table[[ {{group}}]]"],
                "cisco": ["show ip mroute[[ {{group}}]]"],
                "h3c": ["display multicast routing-table[[ {{group}}]]"]},
     "note": "排障顺序：有 (S,G) 表项吗 → 上游对不对 → 出接口有没有用户。"}
  ]
}