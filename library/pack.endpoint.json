{
  "pack": "endpoint",
  "meta": {
    "name": "终端命令扩展包（Linux / Windows / NAS）",
    "version": "0.1.0",
    "updated": "2026-11-06",
    "vendors": {
      "linux": "Linux（Ubuntu / CentOS / Debian 通用）",
      "windows": "Windows Server（PowerShell / CMD）",
      "nas": "NAS（群晖 DSM / 威联通 QTS，Linux 底层）"
    },
    "note": "终端侧只读排查命令为主；改配置类命令都标了风险级别，执行前请确认。"
  },
  "commands": [
    {
      "id": "linux.ls",
      "category": "Linux 文件",
      "title": "列目录（含隐藏文件与大小）",
      "keywords": [
        "ls",
        "列目录",
        "查看文件"
      ],
      "risk": "read-only",
      "params": {
        "req": [],
        "opt": [
          "path"
        ],
        "ex": {
          "path": "/var/log"
        }
      },
      "defaults": {
        "path": "/var/log"
      },
      "config": {
        "linux": [
          "ls -alh {{path}}"
        ]
      },
      "note": "排查时先看目录里有没有异常大的日志或核心转储文件。"
    },
    {
      "id": "linux.find_files",
      "category": "Linux 文件",
      "title": "按文件名查找",
      "keywords": [
        "find",
        "查找文件",
        "搜索"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "name"
        ],
        "opt": [
          "path"
        ],
        "ex": {
          "name": "*.conf",
          "path": "/etc"
        }
      },
      "defaults": {
        "path": "/etc"
      },
      "config": {
        "linux": [
          "find {{path}} -name \"{{name}}\" 2>/dev/null | head -50"
        ]
      }
    },
    {
      "id": "linux.find_large",
      "category": "Linux 文件",
      "title": "找出大于指定大小的文件",
      "keywords": [
        "大文件",
        "磁盘占满",
        "find"
      ],
      "risk": "read-only",
      "params": {
        "req": [],
        "opt": [
          "path",
          "size"
        ],
        "ex": {
          "path": "/",
          "size": "+500M"
        }
      },
      "defaults": {
        "path": "/",
        "size": "+500M"
      },
      "config": {
        "linux": [
          "find {{path}} -xdev -type f -size {{size}} -exec ls -lh {} \\; 2>/dev/null | head -30"
        ]
      },
      "note": "磁盘告警时先跑这个，再决定清理还是扩容。"
    },
    {
      "id": "linux.grep",
      "category": "Linux 文件",
      "title": "在文件里搜索关键字",
      "keywords": [
        "grep",
        "搜索内容",
        "日志检索"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "keyword"
        ],
        "opt": [
          "path"
        ],
        "ex": {
          "keyword": "ERROR",
          "path": "/var/log"
        }
      },
      "defaults": {
        "path": "/var/log"
      },
      "config": {
        "linux": [
          "grep -rn --include='*.log' \"{{keyword}}\" {{path}} 2>/dev/null | tail -50"
        ]
      }
    },
    {
      "id": "linux.tar_backup",
      "category": "Linux 文件",
      "title": "打包目录做备份",
      "keywords": [
        "tar",
        "打包",
        "备份"
      ],
      "risk": "low",
      "params": {
        "req": [
          "path",
          "out"
        ],
        "ex": {
          "path": "/etc",
          "out": "/tmp/etc.tar.gz"
        }
      },
      "config": {
        "linux": [
          "tar -czf {{out}} {{path}}"
        ]
      },
      "verify": {
        "linux": [
          "tar -tzf {{out}} | head"
        ]
      }
    },
    {
      "id": "linux.rsync",
      "category": "Linux 文件",
      "title": "同步目录（增量）",
      "keywords": [
        "rsync",
        "同步",
        "备份"
      ],
      "risk": "medium",
      "params": {
        "req": [
          "src",
          "dst"
        ],
        "ex": {
          "src": "/data/",
          "dst": "backup:/data/"
        }
      },
      "config": {
        "linux": [
          "rsync -avz --progress {{src}} {{dst}}"
        ]
      },
      "note": "目标端带冒号表示走 SSH；不加 --delete，避免误删对端文件。"
    },
    {
      "id": "linux.chmod",
      "category": "Linux 权限",
      "title": "修改文件权限",
      "keywords": [
        "chmod",
        "权限",
        "755"
      ],
      "risk": "medium",
      "params": {
        "req": [
          "mode",
          "path"
        ],
        "ex": {
          "mode": "755",
          "path": "/opt/app"
        }
      },
      "config": {
        "linux": [
          "chmod -R {{mode}} {{path}}"
        ]
      },
      "verify": {
        "linux": [
          "ls -ld {{path}}"
        ]
      }
    },
    {
      "id": "linux.chown",
      "category": "Linux 权限",
      "title": "修改属主与属组",
      "keywords": [
        "chown",
        "属主",
        "属组"
      ],
      "risk": "medium",
      "params": {
        "req": [
          "user",
          "path"
        ],
        "opt": [
          "group"
        ],
        "ex": {
          "user": "nginx",
          "path": "/var/www"
        }
      },
      "config": {
        "linux": [
          "chown -R {{user}}[[.{{group}}]] {{path}}"
        ]
      },
      "verify": {
        "linux": [
          "ls -ld {{path}}"
        ]
      }
    },
    {
      "id": "linux.ps_top",
      "category": "Linux 进程",
      "title": "CPU 占用最高的 10 个进程",
      "keywords": [
        "ps",
        "cpu",
        "进程",
        "卡"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "ps aux --sort=-%cpu | head -11"
        ]
      }
    },
    {
      "id": "linux.mem_top",
      "category": "Linux 进程",
      "title": "内存占用最高的 10 个进程",
      "keywords": [
        "ps",
        "内存",
        "oom"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "ps aux --sort=-%mem | head -11"
        ]
      }
    },
    {
      "id": "linux.pgrep",
      "category": "Linux 进程",
      "title": "按名字查进程 PID",
      "keywords": [
        "pgrep",
        "pid",
        "进程"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "name"
        ],
        "ex": {
          "name": "nginx"
        }
      },
      "config": {
        "linux": [
          "pgrep -a {{name}}"
        ]
      }
    },
    {
      "id": "linux.kill",
      "category": "Linux 进程",
      "title": "强制结束进程",
      "keywords": [
        "kill",
        "结束进程"
      ],
      "risk": "high",
      "params": {
        "req": [
          "pid"
        ],
        "ex": {
          "pid": "12345"
        }
      },
      "config": {
        "linux": [
          "kill -9 {{pid}}"
        ]
      },
      "note": "先 kill -15 让它自己退出，无响应再 -9。"
    },
    {
      "id": "linux.systemctl_status",
      "category": "Linux 服务",
      "title": "查看服务状态",
      "keywords": [
        "systemctl",
        "服务",
        "status"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "service"
        ],
        "ex": {
          "service": "nginx"
        }
      },
      "config": {
        "linux": [
          "systemctl status {{service}} --no-pager -l"
        ]
      }
    },
    {
      "id": "linux.systemctl_restart",
      "category": "Linux 服务",
      "title": "重启服务",
      "keywords": [
        "systemctl",
        "restart",
        "重启"
      ],
      "risk": "medium",
      "params": {
        "req": [
          "service"
        ],
        "ex": {
          "service": "nginx"
        }
      },
      "config": {
        "linux": [
          "systemctl restart {{service}}"
        ]
      },
      "verify": {
        "linux": [
          "systemctl is-active {{service}}"
        ]
      }
    },
    {
      "id": "linux.systemctl_enable",
      "category": "Linux 服务",
      "title": "设置开机自启并立即启动",
      "keywords": [
        "systemctl",
        "enable",
        "自启"
      ],
      "risk": "medium",
      "params": {
        "req": [
          "service"
        ],
        "ex": {
          "service": "docker"
        }
      },
      "config": {
        "linux": [
          "systemctl enable --now {{service}}"
        ]
      },
      "verify": {
        "linux": [
          "systemctl is-enabled {{service}}"
        ]
      }
    },
    {
      "id": "linux.journal_unit",
      "category": "Linux 服务",
      "title": "查看某个服务的日志",
      "keywords": [
        "journalctl",
        "日志",
        "服务"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "service"
        ],
        "ex": {
          "service": "nginx"
        }
      },
      "config": {
        "linux": [
          "journalctl -u {{service}} -n 100 --no-pager"
        ]
      }
    },
    {
      "id": "linux.failed_units",
      "category": "Linux 服务",
      "title": "列出启动失败的服务",
      "keywords": [
        "systemctl",
        "failed",
        "故障"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "systemctl --failed --no-pager"
        ]
      }
    },
    {
      "id": "linux.uptime",
      "category": "Linux 性能",
      "title": "查看负载与运行时长",
      "keywords": [
        "uptime",
        "负载",
        "load"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "uptime"
        ]
      },
      "note": "load 持续高于 CPU 核数说明排队严重。"
    },
    {
      "id": "linux.vmstat",
      "category": "Linux 性能",
      "title": "系统整体状态（CPU/内存/IO）",
      "keywords": [
        "vmstat",
        "性能",
        "io"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "vmstat 1 5"
        ]
      }
    },
    {
      "id": "linux.free",
      "category": "Linux 性能",
      "title": "查看内存与 swap",
      "keywords": [
        "free",
        "内存",
        "swap"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "free -h"
        ]
      }
    },
    {
      "id": "linux.ip_addr",
      "category": "Linux 网络",
      "title": "查看所有网卡 IP",
      "keywords": [
        "ip",
        "addr",
        "ip地址"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "ip -br addr"
        ]
      }
    },
    {
      "id": "linux.ip_link",
      "category": "Linux 网络",
      "title": "查看网卡物理状态",
      "keywords": [
        "ip link",
        "网卡",
        "down"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "ip -s link"
        ]
      }
    },
    {
      "id": "linux.route",
      "category": "Linux 网络",
      "title": "查看路由表",
      "keywords": [
        "route",
        "路由",
        "网关"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "ip route"
        ]
      }
    },
    {
      "id": "linux.ping",
      "category": "Linux 网络",
      "title": "连通性测试",
      "keywords": [
        "ping",
        "不通",
        "丢包"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "host"
        ],
        "ex": {
          "host": "8.8.8.8"
        }
      },
      "config": {
        "linux": [
          "ping -c 4 -W 2 {{host}}"
        ]
      }
    },
    {
      "id": "linux.tracepath",
      "category": "Linux 网络",
      "title": "路由追踪",
      "keywords": [
        "traceroute",
        "tracepath",
        "跳数"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "host"
        ],
        "ex": {
          "host": "10.0.0.1"
        }
      },
      "config": {
        "linux": [
          "tracepath -m 15 {{host}}"
        ]
      }
    },
    {
      "id": "linux.ss",
      "category": "Linux 网络",
      "title": "查看监听端口与对应进程",
      "keywords": [
        "ss",
        "netstat",
        "端口"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "ss -lntup"
        ]
      }
    },
    {
      "id": "linux.dig",
      "category": "Linux 网络",
      "title": "DNS 解析测试",
      "keywords": [
        "dig",
        "nslookup",
        "dns"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "domain"
        ],
        "opt": [
          "dns"
        ],
        "ex": {
          "domain": "example.com",
          "dns": "223.5.5.5"
        }
      },
      "config": {
        "linux": [
          "dig +short {{domain}}[[ @{{dns}}]]"
        ]
      }
    },
    {
      "id": "linux.curl_test",
      "category": "Linux 网络",
      "title": "HTTP 接口连通性测试",
      "keywords": [
        "curl",
        "http",
        "接口"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "url"
        ],
        "ex": {
          "url": "http://127.0.0.1:8080/health"
        }
      },
      "config": {
        "linux": [
          "curl -sS -I --max-time 5 {{url}}"
        ]
      }
    },
    {
      "id": "linux.tcpdump",
      "category": "Linux 网络",
      "title": "抓包（按主机过滤）",
      "keywords": [
        "tcpdump",
        "抓包",
        "丢包"
      ],
      "risk": "medium",
      "params": {
        "req": [
          "iface",
          "host"
        ],
        "ex": {
          "iface": "eth0",
          "host": "10.0.0.5"
        }
      },
      "config": {
        "linux": [
          "tcpdump -i {{iface}} -nn host {{host}} -c 30"
        ]
      },
      "note": "只抓 30 个包就停，避免刷屏；需要 root。"
    },
    {
      "id": "linux.ethtool",
      "category": "Linux 网络",
      "title": "查看网卡速率与双工",
      "keywords": [
        "ethtool",
        "速率",
        "双工",
        "丢包"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "iface"
        ],
        "ex": {
          "iface": "eth0"
        }
      },
      "config": {
        "linux": [
          "ethtool {{iface}}"
        ]
      },
      "note": "看 Speed/Duplex 是否与对端一致，不一致会大量丢包。"
    },
    {
      "id": "linux.bond_status",
      "category": "Linux 网络",
      "title": "查看 bond 绑定状态",
      "keywords": [
        "bond",
        "链路聚合",
        "双网卡"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "cat /proc/net/bonding/bond0 2>/dev/null || ls /proc/net/bonding/"
        ]
      }
    },
    {
      "id": "linux.df",
      "category": "Linux 磁盘",
      "title": "查看磁盘使用率",
      "keywords": [
        "df",
        "磁盘满",
        "空间"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "df -hT"
        ]
      }
    },
    {
      "id": "linux.du",
      "category": "Linux 磁盘",
      "title": "查看目录占用排行",
      "keywords": [
        "du",
        "目录大小",
        "占满"
      ],
      "risk": "read-only",
      "params": {
        "req": [],
        "opt": [
          "path"
        ],
        "ex": {
          "path": "/var"
        }
      },
      "defaults": {
        "path": "/var"
      },
      "config": {
        "linux": [
          "du -sh {{path}}/* 2>/dev/null | sort -h | tail -20"
        ]
      }
    },
    {
      "id": "linux.inode",
      "category": "Linux 磁盘",
      "title": "查看 inode 使用率",
      "keywords": [
        "inode",
        "磁盘满",
        "文件数"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "df -i"
        ]
      },
      "note": "空间没满但写不进去，多半是 inode 用尽。"
    },
    {
      "id": "linux.lsblk",
      "category": "Linux 磁盘",
      "title": "查看块设备与分区",
      "keywords": [
        "lsblk",
        "磁盘",
        "分区"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT"
        ]
      }
    },
    {
      "id": "linux.smart",
      "category": "Linux 磁盘",
      "title": "查看硬盘 SMART 健康",
      "keywords": [
        "smartctl",
        "硬盘",
        "坏道"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "disk"
        ],
        "ex": {
          "disk": "/dev/sda"
        }
      },
      "config": {
        "linux": [
          "smartctl -H -A {{disk}}"
        ]
      }
    },
    {
      "id": "linux.dmesg",
      "category": "Linux 日志",
      "title": "查看内核日志（硬件/驱动报错）",
      "keywords": [
        "dmesg",
        "内核",
        "报错"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "dmesg -T | tail -60"
        ]
      }
    },
    {
      "id": "linux.auth_log",
      "category": "Linux 日志",
      "title": "查看登录与认证日志",
      "keywords": [
        "auth.log",
        "secure",
        "登录失败",
        "爆破"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "tail -n 80 /var/log/auth.log 2>/dev/null || tail -n 80 /var/log/secure"
        ]
      }
    },
    {
      "id": "linux.journal_tail",
      "category": "Linux 日志",
      "title": "查看系统日志（最近 100 行）",
      "keywords": [
        "journalctl",
        "系统日志"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "journalctl -xe -n 100 --no-pager"
        ]
      }
    },
    {
      "id": "linux.log_size",
      "category": "Linux 日志",
      "title": "按大小排日志文件",
      "keywords": [
        "日志",
        "占用",
        "清理"
      ],
      "risk": "read-only",
      "config": {
        "linux": [
          "du -ah /var/log 2>/dev/null | sort -h | tail -20"
        ]
      }
    },
    {
      "id": "linux.apt_update",
      "category": "Linux 软件包",
      "title": "刷新软件源并列出可升级包",
      "keywords": [
        "apt",
        "update",
        "升级"
      ],
      "risk": "medium",
      "config": {
        "linux": [
          "apt update && apt list --upgradable 2>/dev/null | head -40"
        ]
      }
    },
    {
      "id": "linux.apt_install",
      "category": "Linux 软件包",
      "title": "安装软件包",
      "keywords": [
        "apt",
        "install",
        "安装"
      ],
      "risk": "medium",
      "params": {
        "req": [
          "pkg"
        ],
        "ex": {
          "pkg": "tcpdump"
        }
      },
      "config": {
        "linux": [
          "apt install -y {{pkg}}"
        ]
      },
      "verify": {
        "linux": [
          "dpkg -l | grep {{pkg}}"
        ]
      },
      "note": "CentOS 用 yum/dnf install，把命令里的 apt 换掉即可。"
    },
    {
      "id": "linux.dpkg_list",
      "category": "Linux 软件包",
      "title": "查找已安装的软件包",
      "keywords": [
        "dpkg",
        "rpm",
        "已安装"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "pkg"
        ],
        "ex": {
          "pkg": "nginx"
        }
      },
      "config": {
        "linux": [
          "dpkg -l | grep -i {{pkg}} || rpm -qa | grep -i {{pkg}}"
        ]
      }
    },
    {
      "id": "linux.user_add",
