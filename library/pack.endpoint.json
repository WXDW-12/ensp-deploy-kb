          "delay": "60"
        }
      },
      "defaults": {
        "delay": "60"
      },
      "config": {
        "windows": [
          "shutdown /r /t {{delay}} /c '计划重启，请保存工作'"
        ]
      },
      "note": "生产环境先确认业务已切走；/t 60 留 60 秒缓冲。"
    },
    {
      "id": "nas.df",
      "category": "NAS 存储",
      "title": "查看卷空间使用",
      "keywords": [
        "df",
        "空间",
        "卷"
      ],
      "risk": "read-only",
      "config": {
        "nas": [
          "df -hT"
        ]
      }
    },
    {
      "id": "nas.btrfs_usage",
      "category": "NAS 存储",
      "title": "查看 btrfs 卷占用（群晖常用）",
      "keywords": [
        "btrfs",
        "卷",
        "空间"
      ],
      "risk": "read-only",
      "params": {
        "req": [],
        "opt": [
          "volume"
        ],
        "ex": {
          "volume": "/volume1"
        }
      },
      "defaults": {
        "volume": "/volume1"
      },
      "config": {
        "nas": [
          "btrfs filesystem usage {{volume}} 2>/dev/null || df -h {{volume}}"
        ]
      }
    },
    {
      "id": "nas.lsblk",
      "category": "NAS 存储",
      "title": "查看磁盘与分区",
      "keywords": [
        "磁盘",
        "分区",
        "lsblk"
      ],
      "risk": "read-only",
      "config": {
        "nas": [
          "lsblk -o NAME,SIZE,TYPE,FSTYPE,MODEL"
        ]
      }
    },
    {
      "id": "nas.mdstat",
      "category": "NAS 存储",
      "title": "查看 RAID 阵列状态",
      "keywords": [
        "raid",
        "mdstat",
        "降级"
      ],
      "risk": "read-only",
      "config": {
        "nas": [
          "cat /proc/mdstat"
        ]
      },
      "note": "看到 [_U] 表示降级，需要尽快换盘重建。"
    },
    {
      "id": "nas.smart",
      "category": "NAS 存储",
      "title": "查看硬盘 SMART 健康",
      "keywords": [
        "smart",
        "坏道",
        "硬盘"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "disk"
        ],
        "ex": {
          "disk": "/dev/sda"
        }
      },
      "config": {
        "nas": [
          "smartctl -H -A {{disk}}"
        ]
      }
    },
    {
      "id": "nas.syno_share",
      "category": "NAS 共享",
      "title": "列出共享文件夹（群晖）",
      "keywords": [
        "共享",
        "synology",
        "synoshare"
      ],
      "risk": "read-only",
      "config": {
        "nas": [
          "synoshare --enum ALL 2>/dev/null || ls /volume1"
        ]
      }
    },
    {
      "id": "nas.syno_quota",
      "category": "NAS 共享",
      "title": "查看用户配额（群晖）",
      "keywords": [
        "配额",
        "quota",
        "空间"
      ],
      "risk": "read-only",
      "params": {
        "req": [
          "user"
        ],
        "ex": {
          "user": "ops"
        }
      },
      "config": {
        "nas": [
          "synoquota --user {{user}} 2>/dev/null || quota -u {{user}} 2>/dev/null || echo '该型号不支持命令行查配额'"
        ]
      }
    },
    {
      "id": "nas.syno_snapshot",
      "category": "NAS 快照",
      "title": "列出快照（群晖）",
      "keywords": [
        "快照",
        "snapshot",
        "恢复"
      ],
      "risk": "read-only",
      "config": {
        "nas": [
          "synosnap --list 2>/dev/null || btrfs subvolume list /volume1 | head -30"
        ]
      }
    },
    {
      "id": "nas.syno_snap_create",
      "category": "NAS 快照",
      "title": "给共享目录打快照（群晖）",
      "keywords": [
        "快照",
        "备份",
        "新建"
      ],
      "risk": "medium",
      "params": {
        "req": [
          "share"
        ],
        "ex": {
          "share": "share01"
        }
      },
      "config": {
        "nas": [
          "synosnap --snapcreate --share {{share}}"
        ]
      },
      "note": "需已启用快照套件；执行前确认卷剩余空间足够。"
    },
    {
      "id": "nas.syno_user",
      "category": "NAS 用户",
      "title": "列出 NAS 用户（群晖）",
      "keywords": [
        "用户",
        "账号",
        "synouser"
      ],
      "risk": "read-only",
      "config": {
        "nas": [
          "synouser --enum 2>/dev/null || cat /etc/passwd | awk -F: '$3>=1000 {print $1}'"
        ]
      }
    },
    {
      "id": "nas.syno_pkg",
      "category": "NAS 系统",
      "title": "查看套件运行状态（群晖）",
      "keywords": [
        "套件",
        "package",
        "运行"
      ],
      "risk": "read-only",
      "config": {
        "nas": [
          "synopkg list --name 2>/dev/null | head -30"
        ]
      }
    },
    {
      "id": "nas.syno_service",
      "category": "NAS 系统",
      "title": "查看 NAS 服务状态（群晖）",
      "keywords": [
        "服务",
        "状态",
        "synoservice"
      ],
      "risk": "read-only",
      "config": {
        "nas": [
          "synoservice --status 2>/dev/null | head -40"
        ]
      }
    },
    {
      "id": "nas.syno_service_restart",
      "category": "NAS 系统",
      "title": "重启 NAS 服务（群晖）",
      "keywords": [
        "服务",
        "重启"
      ],
      "risk": "medium",
      "params": {
        "req": [
          "service"
        ],
        "ex": {
          "service": "smbd"
        }
      },
      "config": {
        "nas": [
          "synoservice --restart {{service}}"
        ]
      },
      "verify": {
        "nas": [
          "synoservice --status | grep -i {{service}}"
        ]
      }
    },
    {
      "id": "nas.net",
      "category": "NAS 系统",
      "title": "查看网卡与 IP",
      "keywords": [
        "网络",
        "ip",
        "网卡"
      ],
      "risk": "read-only",
      "config": {
        "nas": [
          "ip -br addr"
        ]
      }
    },
    {
      "id": "nas.nfs_exports",
      "category": "NAS 共享",
      "title": "查看 NFS 导出列表",
      "keywords": [
        "nfs",
        "导出",
        "挂载"
      ],
      "risk": "read-only",
      "config": {
        "nas": [
          "cat /etc/exports 2>/dev/null || echo '未配置 NFS'"
        ]
      }
    },
    {
      "id": "nas.smb_status",
      "category": "NAS 共享",
      "title": "查看 SMB 当前连接",
      "keywords": [
        "smb",
        "连接",
        "共享"
      ],
      "risk": "read-only",
      "config": {
        "nas": [
          "smbstatus 2>/dev/null | head -30 || echo 'smbstatus 不可用'"
        ]
      }
    },
    {
      "id": "nas.log_messages",
      "category": "NAS 日志",
      "title": "查看系统日志",
      "keywords": [
        "日志",
        "messages",
        "报错"
      ],
      "risk": "read-only",
      "config": {
        "nas": [
          "tail -n 100 /var/log/messages 2>/dev/null || tail -n 100 /var/log/syslog"
        ]
      }
    },
    {
      "id": "nas.temp",
      "category": "NAS 系统",
      "title": "查看温度传感器",
      "keywords": [
        "温度",
        "过热",
        "风扇"
      ],
      "risk": "read-only",
      "config": {
        "nas": [
          "for z in /sys/class/thermal/thermal_zone*; do echo -n \"$z \"; cat $z/temp; done 2>/dev/null"
        ]
      },
      "note": "数值除以 1000 得摄氏度；持续 60 度以上要检查风扇和灰尘。"
    }
  ]
}
